# Manifest for the l5-aws and l2-proxy harnesses in aerospike-client-conformance (l5-aws/README.md and
# l2-proxy/README.md there). Each command runs with bash on Amazon Linux 2023 from the repository root.
# The harnesses clone the repository without its submodules, so L5_BUILD checks out the C client.
# The clone can belong to another user than the build, so the build marks it safe for git.
L5_SETUP='sudo dnf install -y -q gcc make autoconf automake libtool git openssl-devel libyaml-devel zlib-devel python3.12 python3.12-devel python3.12-pip'
# The test requirements are for L2_RUN, whose container has no network.
L5_BUILD='git config --global --add safe.directory "$PWD" && git submodule update --init --recursive && python3.12 -m venv .l5-venv && .l5-venv/bin/pip install -q build && .l5-venv/bin/python -m build --wheel && .l5-venv/bin/pip install -q dist/aerospike-*.whl -r test/discovery/requirements.txt'
# The harness appends its flags. Client messages up to debug level (node add, remove and address
# changes, peer and partition-map updates) reach the row log as DRIVER-STDERR client-log lines, in
# every harness that runs this manifest (L2, L3 and L5).
L5_DRIVER='.l5-venv/bin/python test/discovery/l5_driver.py --client-log debug'
# L2_RUN is the l2-proxy harness's hook for a client's own L2 tests (l2-proxy/README.md there).
L2_RUN='test/discovery/l2_run.sh'
